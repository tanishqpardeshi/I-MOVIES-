# ==========================================
# iMovies - Environment Configuration Template
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
# Port for Express server and Vite development server
PORT=3000

# Application environment ('development' | 'production')
NODE_ENV=development

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Secret key used for signing JWT tokens (must be at least 32 characters long)
JWT_SECRET=imovies_super_secret_jwt_key_that_is_at_least_32_characters_long

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# MongoDB connection URI (e.g. mongodb://localhost:27017/imovies or MongoDB Atlas URI)
# If omitted or unavailable, iMovies seamlessly falls back to the resilient in-memory database store
MONGO_URI=

# ------------------------------------------
# External APIs & Metadata
# ------------------------------------------
# The Movie Database (TMDB) API Key (v3 auth)
# Used for fetching dynamic movie details, trailers, and posters.
# If omitted, local high-resolution poster assets and curated catalogue are used.
TMDB_API_KEY=

# ------------------------------------------
# Client / Frontend Configuration
# ------------------------------------------
# Base API URL for frontend axios client.
# Leave blank to use relative same-origin /api routing (recommended for development & production)
VITE_API_URL=

# ------------------------------------------
# Database Seeding Configuration (server/seed.js)
# ------------------------------------------
# Enable destructive database resets (must be 'true' and run with --reset to take effect)
SEED_ALLOW_DESTRUCTIVE=false

# Passwords for seeded admin and standard test user accounts (min 12 characters)
SEED_ADMIN_PASSWORD=AdminSecurePassword123!
SEED_USER_PASSWORD=UserSecurePassword123!